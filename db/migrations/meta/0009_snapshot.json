      "definition": "select \"photo_jobs\".\"id\", \"photo_jobs\".\"photo_id\", \"photos\".\"event_id\", \"photos\".\"uploader_user_id\", \"photo_jobs\".\"attempts\", \"photo_jobs\".\"last_error\", \"photo_jobs\".\"last_error_at\", \"photo_jobs\".\"failed_at\" from \"photo_jobs\" inner join \"photos\" on \"photos\".\"id\" = \"photo_jobs\".\"photo_id\" where (\"photo_jobs\".\"state\" = 'failed' and \"photo_jobs\".\"failed_at\" > now() - interval '7 days') order by \"photo_jobs\".\"failed_at\" desc",
