# =============================================================================
# phostro — environment variables
# =============================================================================
# Copy to `.env.local` for dev. In prod, set these in the deploy target's
# secret store (Vercel/Fly/etc.). The server validates required vars at boot
# (see `instrumentation.ts` → `lib/env.ts`); a missing required var in
# production prevents the server from starting.
#
# Order: required-everywhere, required-in-production, optional, test-only,
# worker-process.
# =============================================================================

# ---- Required everywhere ----------------------------------------------------

# Postgres connection. In prod, use the Supabase pooler URL. In dev, the local
# Docker DB on :54330 (see docker-compose.yml).
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# iron-session secret. Must be ≥32 chars. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Public origin of the deployed app. Used to build absolute redirect URLs
# from the magic-link verify route. Dev: http://localhost:3000.
# Prod: https://your-domain (no trailing slash).
APP_URL=http://localhost:3000

# ---- Required in production -------------------------------------------------
# These are gated by NODE_ENV. In dev they're optional (magic-link emails get
# skipped silently when RESEND_API_KEY is unset; photo upload throws on first
# use without R2 keys).

# Resend API key for magic-link delivery. Get one at https://resend.com.
RESEND_API_KEY=

# Cloudflare R2 (S3-compatible) for photo storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Face-match worker (separate Python process — see `worker/`).
# WORKER_URL is the worker's HTTP origin; WORKER_SECRET is the shared HMAC
# secret enforced on every worker request.
WORKER_URL=http://localhost:8000
WORKER_SECRET=

# ---- Optional ---------------------------------------------------------------

# Sentry DSN. Sentry initializes only when NODE_ENV=production AND this is set
# (see lib/observability/logger.ts). Leave blank in dev/test.
SENTRY_DSN=

# Pino log level. Default: 'info'. Use 'debug' for verbose, 'warn' to quiet.
LOG_LEVEL=

# Logger service tag. Default: 'web'. The dispatcher script overrides this
# to 'dispatcher'. Other values are accepted but unrecognized.
SERVICE_NAME=

# ---- Test-only --------------------------------------------------------------

# Vitest reads from this when running against the local test DB on :54329
# (see docker-compose.test.yml, scripts test:db:up / test:db:migrate).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres

# =============================================================================
# Worker process (worker/) — Python service, separate from Next
# =============================================================================
# These are NOT read by the Next app. Set them on the worker's environment
# (Docker compose, fly.io, etc.). Documented here for completeness.
#
#   WORKER_SECRET             — must match the Next app's WORKER_SECRET above
#   WORKER_MODELS_DIR         — path to ONNX models. Default: /models
#   WORKER_CONCURRENCY        — int or 'auto'. Default: 'auto'
#   WORKER_ENV                — set to 'production' to enable Sentry
#   SENTRY_DSN                — same DSN as the web app, or worker-specific
#   SENTRY_TRACES_SAMPLE_RATE — float, default 0.1
#   GIT_COMMIT_SHA            — release tag for Sentry. Default: 'unknown'
